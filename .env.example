FLASK_SECRET_KEY=replace-with-strong-secret
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# Cache
CACHE_DEFAULT_TIMEOUT=900
CACHE_REDIS_URL=redis://127.0.0.1:6379/0
CHAPTER_REFERENCE_CACHE_TTL=900

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional SMTP (for email features)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
